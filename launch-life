#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
APP_DIR="$(cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd)"
APP_URL="http://localhost:8787"

if ! command -v node >/dev/null 2>&1; then
  printf 'Node.js is required to run the local preview.\n' >&2
  exit 1
fi

start_server() {
  if command -v setsid >/dev/null 2>&1; then
    (cd "$APP_DIR" && setsid -f node server.js >/tmp/life-server.log 2>&1)
  else
    (cd "$APP_DIR" && nohup node server.js >/tmp/life-server.log 2>&1 &)
  fi
}

if ! curl -fsS "$APP_URL/rooms.js" >/dev/null 2>&1; then
  start_server
  for _ in {1..40}; do
    if curl -fsS "$APP_URL/rooms.js" >/dev/null 2>&1; then
      break
    fi
    sleep 0.1
  done
  if ! curl -fsS "$APP_URL/rooms.js" >/dev/null 2>&1; then
    printf 'Life preview failed to start. See /tmp/life-server.log.\n' >&2
    exit 1
  fi
fi

if command -v xdg-open >/dev/null 2>&1; then
  xdg-open "$APP_URL" >/dev/null 2>&1 &
elif command -v gio >/dev/null 2>&1; then
  gio open "$APP_URL" >/dev/null 2>&1 &
else
  printf 'Open this URL in your browser: %s\n' "$APP_URL"
fi
